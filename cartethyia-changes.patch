+function repeat(levels: LevelValues, n: number): LevelValues[] {
+  return Array.from({ length: n }, () => levels);
+}
+
+function move(
+  id: string,
+  name: string,
+  type: Attack["type"],
+  hitsPercent: LevelValues[],
+  damageBonusType?: Attack["type"],
