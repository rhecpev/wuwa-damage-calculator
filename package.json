{
  "name": "wuthering-damage-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch:api": "node scripts/fetch-encore.mjs",
    "build:weapons": "node scripts/build-weapons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:triggers": "node scripts/check-attack-triggers.mjs",
    "check:echoes": "node scripts/check-echo-excludes.mjs",
    "check": "npm run typecheck && npm run check:triggers && npm run check:echoes && npm run check:echobuffs",
    "check:echobuffs": "node scripts/check-echo-ability-buffs.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.0.0",
    "electron-is-dev": "^3.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
